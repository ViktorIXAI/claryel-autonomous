{
 "exe": "$HOME/Strata/engine-cuda12/strata",
 "args": [
  "--pack",
  "$HOME/Strata-data/packs/iq3_s",
  "--native",
  "$HOME/Strata-data/models/IQ3_S-q8d/Qwen3.8-Flash-Next-GSQ-RCO-IQ3_S-00001-of-00002.gguf",
  "--ple-gguf",
  "$HOME/Strata-data/models/IQ3_S-q8d/Qwen3.8-Flash-Next-GSQ-RCO-IQ3_S-00002-of-00002.gguf",
  "--expert-profile",
  "$HOME/Strata/repo/data/expert-profile.bin",
  "--expert-cache",
  "auto",
  "--prefill",
  "4096",
  "--spec",
  "4",
  "--spec-min-p",
  "0.5",
  "--mtp",
  "$HOME/Strata-data/mtp/rt",
  "--max-context",
  "32768",
  "--kv",
  "int8",
  "--mmap-experts",
  "--vision",
  "--vram-reserve-mib",
  "512",
  "--pool-workers",
  "16",
  "--resident-experts",
  "--resident-budget-gib",
  "25",
  "--memory-limit-mib",
  "28672"
