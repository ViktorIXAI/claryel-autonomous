  "STRATA_UNBUFFERED_LOAD": "1",
  "STRATA_ROUTE_PRIOR": "1.5",
  "STRATA_RESIDENT_HEADROOM_GIB": "1"
 },
 "vision": {
  "exe": "$HOME/Strata/engine-cuda12/strata-vision",
  "mmproj": "$HOME/Strata-data/models/mmproj-Qwen3.8-Flash-Next-BF16.gguf",
  "model": "$HOME/Strata-data/models/IQ3_S/Qwen3.8-Flash-Next-GSQ-RCO-IQ3_S-00001-of-00002.gguf",
  "gpu": false,
  "max_tokens": 300,
  "threads": 14
 },
 "host": "0.0.0.0"
}
