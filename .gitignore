__pycache__/
*.pyc
.venv/
config.sh
*.stamp
state*.json
results*.jsonl
gate-ledger*.jsonl
artifacts/
# Pinned audit artifacts demanded by external audit issue #10 (redacted traces)
!benchmarks/hard/audit-20261105/artifacts/
!benchmarks/hard/audit-20261105/artifacts/results-v5fix.jsonl
!benchmarks/hard/audit-20261105/artifacts/run-record-v5fix.json
!benchmarks/hard/audit-20261105/artifacts/v5fix.log

# Local-only publication and security state
*.env
!*.env.example
security-report*.json
security-report*.md

# keep published samples
!logs/samples/**
!logs/samples/**/*.jsonl

# hard-v6: keep raw arm dumps reviewable — prefer names outside results*.jsonl
# e.g. benchmarks/hard/audit-YYYYMMDD/artifacts/ or runs/<stamp>/raw-answers.jsonl
# (results*.jsonl remains ignored unless explicitly negated like audit-20261105)
!benchmarks/hard/v6-results/
!benchmarks/hard/v6-results/*.jsonl
!benchmarks/hard/v6-results/*.csv
!benchmarks/hard/v6-results/*.log
!benchmarks/hard/v6-results/*.md
# 2026-11-05: the single-star rules above never matched the per-arm subdirectories
# (full-2NN/, k-218/, j-probe-218/), so `results*.jsonl` answer rows were silently
# unpublished for contour arms 0.0.2.18-0.0.2.23 while their ledgers shipped. Ship
# every sanitized artifact at any depth under v6-results/.
!benchmarks/hard/v6-results/**/*.jsonl
!benchmarks/hard/v6-results/**/*.csv
!benchmarks/hard/v6-results/**/*.log
!benchmarks/hard/v6-results/**/*.md
