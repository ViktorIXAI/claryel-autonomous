{"id": "E-ex6-00", "cat": "E", "answer": "def merge_deep(a, b):\n    out = dict(a)\n    for k, v in b.items():\n        if k in out and isinstance(out[k], dict) and isinstance(v, dict):\n            out[k] = merge_deep(out[k], v)\n        else:\n            out[k] = v\n    return out"}
{"id": "E-ex6-01", "cat": "E", "answer": "def parse_ranges(s):\n    out = []\n    for part in s.split(','):\n        part = part.strip()\n        if not part:\n            continue\n        if '-' in part:\n            lo, hi = part.split('-', 1)\n            out.extend(range(int(lo), int(hi) + 1))\n        else:\n            out.append(int(part))\n    return sorted(set(out))"}
{"id": "E-ex6-02", "cat": "E", "answer": "def top_k(nums, k):\n    idx = sorted(range(len(nums)), key=lambda i: (-nums[i], i))\n    return [nums[i] for i in idx[:k]]"}
{"id": "E-ex6-03", "cat": "E", "answer": "from decimal import Decimal, ROUND_HALF_UP\n\ndef money_round(x):\n    return float(Decimal(str(x)).quantize(Decimal('0.01'), rounding=ROUND_HALF_UP))"}
{"id": "E-ex6-04", "cat": "E", "answer": "def slugify(s):\n    import re\n    s = s.lower()\n    s = re.sub(r'[^a-z0-9]+', '-', s)\n    return s.strip('-')"}
{"id": "E-ex6-05", "cat": "E", "answer": "def parse_duration(s):\n    import re\n    h = re.search(r'(\\d+)h', s)\n    m = re.search(r'(\\d+)m(?!s)', s)\n    sec = re.search(r'(\\d+)s', s)\n    return (int(h.group(1)) * 3600 if h else 0) + (int(m.group(1)) * 60 if m else 0) + (int(sec.group(1)) if sec else 0)"}
{"id": "E-ex6-06", "cat": "E", "answer": "def chunk_even(lst, n):\n    if n <= 0:\n        return []\n    base, extra = divmod(len(lst), n)\n    out, pos = [], 0\n    for i in range(n):\n        sz = base + (1 if i < extra else 0)\n        out.append(lst[pos:pos + sz])\n        pos += sz\n    return out"}
{"id": "E-ex6-07", "cat": "E", "answer": "def norm_phone(s):\n    d = ''.join(c for c in s if c.isdigit())\n    if d.startswith('8'):\n        d = '7' + d[1:]\n    if len(d) == 10:\n        d = '7' + d\n    return d if len(d) == 11 else None"}
{"id": "E-ex6-08", "cat": "E", "answer": "def find_gaps(a):\n    if not a:\n        return []\n    s = set(a)\n    return [x for x in range(a[0], a[-1] + 1) if x not in s]"}
{"id": "E-ex6-09", "cat": "E", "answer": "def intersect_sorted(a, b):\n    return sorted(set(a) & set(b))"}
