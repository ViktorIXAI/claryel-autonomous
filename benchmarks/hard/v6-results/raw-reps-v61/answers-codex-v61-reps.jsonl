{"task": "E-ex6-05", "rep": 1, "cat": "E", "answer": "def parse_duration(s):\n    import re\n    h = re.search(r'(\\d+)h', s)\n    m = re.search(r'(\\d+)m', s)\n    sec = re.search(r'(\\d+)s', s)\n    return (\n        (int(h.group(1)) * 3600 if h else 0)\n        + (int(m.group(1)) * 60 if m else 0)\n        + (int(sec.group(1)) if sec else 0)\n    )", "finish": "ok", "seconds": 12.7, "arm": "codex", "mode": "strict_plain", "model": "gpt-6.1-sol", "cli": "codex codex-cli 0.166.0", "bank_sha16": "9ec86dfca4a6f85f"}
{"task": "E-ex6-06", "rep": 1, "cat": "E", "answer": "def chunk_even(lst, n):\n    if n <= 0:\n        return []\n    k, r = divmod(len(lst), n)\n    return [\n        lst[i * k + min(i, r):(i + 1) * k + min(i + 1, r)]\n        for i in range(n)\n    ]", "finish": "ok", "seconds": 9.4, "arm": "codex", "mode": "strict_plain", "model": "gpt-6.1-sol", "cli": "codex codex-cli 0.166.0", "bank_sha16": "9ec86dfca4a6f85f"}
