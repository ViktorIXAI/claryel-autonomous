{"task": "E-ex6-03", "rep": 3, "cat": "E", "answer": "def money_round(x):\n    from decimal import Decimal, ROUND_HALF_UP, localcontext\n\n    value = Decimal(str(x))\n    if not value.is_finite():\n        return float(value)\n\n    with localcontext() as ctx:\n        ctx.prec = max(ctx.prec, value.adjusted() + 4)\n        return float(value.quantize(Decimal(\"0.01\"), rounding=ROUND_HALF_UP))", "finish": "ok", "seconds": 21.2, "arm": "codex", "mode": "strict_plain", "model": "gpt-6.1-sol", "cli": "codex codex-cli 0.166.0", "bank_sha16": "9ec86dfca4a6f85f"}
{"task": "E-ex6-04", "rep": 3, "cat": "E", "answer": "def slugify(s):\n    import re\n    s = s.lower()\n    s = re.sub(r'[^a-z0-9]+', '-', s)\n    return s.strip('-')", "finish": "ok", "seconds": 7.2, "arm": "codex", "mode": "strict_plain", "model": "gpt-6.1-sol", "cli": "codex codex-cli 0.166.0", "bank_sha16": "9ec86dfca4a6f85f"}
{"task": "E-ex6-05", "rep": 3, "cat": "E", "answer": "def parse_duration(s):\n    import re\n    h = re.search(r'(\\d+)h', s)\n    m = re.search(r'(\\d+)m', s)\n    sec = re.search(r'(\\d+)s', s)\n    return (\n        (int(h.group(1)) * 3600 if h else 0)\n        + (int(m.group(1)) * 60 if m else 0)\n        + (int(sec.group(1)) if sec else 0)\n    )", "finish": "ok", "seconds": 13.2, "arm": "codex", "mode": "strict_plain", "model": "gpt-6.1-sol", "cli": "codex codex-cli 0.166.0", "bank_sha16": "9ec86dfca4a6f85f"}
{"task": "E-ex6-06", "rep": 3, "cat": "E", "answer": "def chunk_even(lst, n):\n    if n <= 0:\n        return []\n    k, r = divmod(len(lst), n)\n    return [\n        lst[i * k + min(i, r):(i + 1) * k + min(i + 1, r)]\n        for i in range(n)\n    ]", "finish": "ok", "seconds": 10.0, "arm": "codex", "mode": "strict_plain", "model": "gpt-6.1-sol", "cli": "codex codex-cli 0.166.0", "bank_sha16": "9ec86dfca4a6f85f"}
{"task": "E-ex6-07", "rep": 3, "cat": "E", "answer": "def norm_phone(s):\n    d = ''.join(c for c in s if c.isdigit())\n    if d.startswith('8'):\n        d = '7' + d[1:]\n    if len(d) == 10:\n        d = '7' + d\n    return d if len(d) == 11 else None", "finish": "ok", "seconds": 9.2, "arm": "codex", "mode": "strict_plain", "model": "gpt-6.1-sol", "cli": "codex codex-cli 0.166.0", "bank_sha16": "9ec86dfca4a6f85f"}
