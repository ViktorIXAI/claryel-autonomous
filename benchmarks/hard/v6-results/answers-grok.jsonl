{"task": "E-ex6-01", "rep": 0, "cat": "E", "answer": "```python\ndef parse_ranges(s):\n    out = []\n    for part in s.split(','):\n        part = part.strip()\n        if '-' in part:\n            lo, hi = part.split('-')\n            out.extend(range(int(lo), int(hi) + 1))\n        elif part:\n            out.append(int(part))\n    return sorted(set(out))\n```", "finish": "ok", "seconds": 15.3, "arm": "grok", "mode": "strict_plain"}
{"task": "E-ex6-02", "rep": 0, "cat": "E", "answer": "def top_k(nums, k):\n    idx = sorted(range(len(nums)), key=lambda i: (-nums[i], i))\n    return [nums[i] for i in idx[:k]]", "finish": "ok", "seconds": 134.8, "arm": "grok", "mode": "strict_plain"}
{"task": "E-ex6-03", "rep": 0, "cat": "E", "answer": "```python\ndef money_round(x):\n    from decimal import Decimal, ROUND_HALF_UP\n    return float(Decimal(str(x)).quantize(Decimal(\"0.01\"), rounding=ROUND_HALF_UP))\n```", "finish": "ok", "seconds": 72.0, "arm": "grok", "mode": "strict_plain"}
{"task": "E-ex6-04", "rep": 0, "cat": "E", "answer": "```python\ndef slugify(s):\n    import re\n    s = s.lower()\n    s = re.sub(r'[^a-z0-9]+', '-', s)\n    return s.strip('-')\n```", "finish": "ok", "seconds": 11.8, "arm": "grok", "mode": "strict_plain"}
{"task": "E-ex6-05", "rep": 0, "cat": "E", "answer": "def parse_duration(s):\n    import re\n    h = re.search(r'(\\d+)h', s)\n    m = re.search(r'(\\d+)m', s)\n    sec = re.search(r'(\\d+)s', s)\n    return (\n        (int(h.group(1)) * 3600 if h else 0)\n        + (int(m.group(1)) * 60 if m else 0)\n        + (int(sec.group(1)) if sec else 0)\n    )", "finish": "ok", "seconds": 31.9, "arm": "grok", "mode": "strict_plain"}
{"task": "E-ex6-06", "rep": 0, "cat": "E", "answer": "```python\ndef chunk_even(lst, n):\n    if n <= 0:\n        return []\n    q, r = divmod(len(lst), n)\n    out = []\n    i = 0\n    for j in range(n):\n        size = q + (1 if j < r else 0)\n        out.append(lst[i:i + size])\n        i += size\n    return out\n```", "finish": "ok", "seconds": 28.7, "arm": "grok", "mode": "strict_plain"}
{"task": "E-ex6-07", "rep": 0, "cat": "E", "answer": "def norm_phone(s):\n    d = ''.join(c for c in s if c.isdigit())\n    if d.startswith('8'):\n        d = '7' + d[1:]\n    if len(d) == 10:\n        d = '7' + d\n    return d if len(d) == 11 else None", "finish": "ok", "seconds": 94.8, "arm": "grok", "mode": "strict_plain"}
