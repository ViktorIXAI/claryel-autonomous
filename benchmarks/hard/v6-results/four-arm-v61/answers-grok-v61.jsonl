{"task": "E-ex6-01", "rep": 0, "cat": "E", "answer": "def parse_ranges(s):\n    out = []\n    for part in s.split(','):\n        part = part.strip()\n        if '-' in part:\n            lo, hi = part.split('-')\n            out.extend(range(int(lo), int(hi) + 1))\n        elif part:\n            out.append(int(part))\n    return sorted(set(out))", "finish": "ok", "seconds": 10.9, "arm": "grok", "mode": "strict_plain"}
{"task": "E-ex6-02", "rep": 0, "cat": "E", "answer": "def top_k(nums, k):\n    order = sorted(range(len(nums)), key=lambda i: (nums[i], -i), reverse=True)\n    return [nums[i] for i in order[:k]]", "finish": "ok", "seconds": 529.0, "arm": "grok", "mode": "strict_plain"}
