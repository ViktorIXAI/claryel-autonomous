{"task": "E-ex6-05", "rep": 0, "cat": "E", "answer": "def parse_duration(s):\n    import re\n    h = re.search(r'(\\d+)h', s)\n    m = re.search(r'(\\d+)m', s)\n    sec = re.search(r'(\\d+)s', s)\n    return (int(h.group(1)) if h else 0) * 3600 + (int(m.group(1)) if m else 0) * 60 + (int(sec.group(1)) if sec else 0)", "finish": "ok", "seconds": 87.5, "arm": "grok", "mode": "strict_plain"}
{"task": "E-ex6-06", "rep": 0, "cat": "E", "answer": "def chunk_even(lst, n):\n    if n <= 0:\n        return []\n    q, r = divmod(len(lst), n)\n    return [lst[i * q + min(i, r):(i + 1) * q + min(i + 1, r)] for i in range(n)]", "finish": "ok", "seconds": 29.2, "arm": "grok", "mode": "strict_plain"}
{"task": "E-ex6-07", "rep": 0, "cat": "E", "answer": "def norm_phone(s):\n    d = ''.join(c for c in s if c.isdigit())\n    if d.startswith('8'):\n        d = '7' + d[1:]\n    if len(d) == 10:\n        d = '7' + d\n    return d if len(d) == 11 else None", "finish": "ok", "seconds": 36.5, "arm": "grok", "mode": "strict_plain"}
