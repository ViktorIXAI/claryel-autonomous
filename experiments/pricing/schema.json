{
  "version": "0.1",
  "id": "claryel-hardware-price-snapshot",
  "description": "Public, dated hardware price observation for reproducible benchmark configurations. Values must come from public sources. Private infrastructure identifiers are prohibited.",
  "type": "object",
  "required": ["observed_at", "region", "currency", "observations"],
  "additionalProperties": false,
  "properties": {
    "observed_at": {"type": "string", "format": "date"},
    "region": {"type": "string"},
    "currency": {"type": "string", "minLength": 3, "maxLength": 3},
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["component", "model", "condition", "price", "source_url", "source_class", "confidence"],
        "additionalProperties": false,
        "properties": {
          "component": {"type": "string"},
          "model": {"type": "string"},
          "mpn": {"type": "string"},
          "sku": {"type": "string"},
          "condition": {"type": "string", "enum": ["new", "refurbished", "used"]},
          "price": {"type": "number", "minimum": 0},
          "availability": {"type": "string", "enum": ["in_stock", "low_stock", "out_of_stock", "unknown"]},
          "source_url": {"type": "string", "format": "uri"},
          "source_class": {"type": "string", "enum": ["manufacturer", "authorized_reseller", "marketplace", "price_aggregator", "manual"]},
          "confidence": {"type": "string", "enum": ["low", "medium", "high"]},
          "notes": {"type": "string"}
        }
      }
    }
  }
}
