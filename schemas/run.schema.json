{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "run record (forward schema)",
 "description": "Native legacy rows (results-*/gate-ledger-*) stay as published; this is the forward schema. Mapping: task->task_id, rep->repetition, contour_version->harness_version, content->score, format_ok->format_ok, ptok->prompt_tokens, ctok->completion_tokens, t_wall->total_latency_s, notes->failure_causes, answer->raw_response_ref (raw kept in run dirs).",
 "type": "object",
 "required": [
  "run_id",
  "timestamp_utc",
  "machine_id",
  "model_id",
  "harness_version",
  "task_id",
  "repetition",
  "status"
 ],
 "properties": {
  "run_id": {
   "type": "string"
  },
  "timestamp_utc": {
   "type": "string"
  },
  "machine_id": {
   "type": "string"
  },
  "model_id": {
   "type": "string"
  },
  "model_hash": {
   "type": [
    "string",
    "null"
   ]
  },
  "quantization": {
   "type": [
    "string",
    "null"
   ]
  },
  "engine_version": {
   "type": [
    "string",
    "null"
   ]
  },
  "harness_version": {
   "type": "string"
  },
  "harness_commit": {
   "type": [
    "string",
    "null"
   ]
  },
  "benchmark_id": {
   "type": "string"
  },
  "task_id": {
   "type": "string"
  },
  "task_version": {
   "type": [
    "string",
    "null"
   ]
  },
  "validator_version": {
   "type": [
    "string",
    "null"
   ]
  },
  "scorer_version": {
   "type": [
    "string",
    "null"
   ]
  },
  "repetition": {
   "type": "integer"
  },
  "status": {
   "enum": [
    "ok",
    "engine_error",
    "truncated",
    "stopped_by_gate",
    "invalid_artifact"
   ]
  },
  "score": {
   "type": [
    "number",
    "null"
   ]
  },
  "perfect": {
   "type": [
    "boolean",
    "null"
   ]
  },
  "format_ok": {
   "type": [
    "boolean",
    "null"
   ]
  },
  "prompt_tokens": {
   "type": [
    "integer",
    "null"
   ]
  },
  "completion_tokens": {
   "type": [
    "integer",
    "null"
   ]
  },
  "ttft_ms": {
   "type": [
    "number",
    "null"
   ]
  },
  "decode_tokens_per_second": {
   "type": [
    "number",
    "null"
   ]
  },
  "total_latency_ms": {
   "type": [
    "number",
    "null"
   ]
  },
  "repair_attempts": {
   "type": [
    "integer",
    "null"
   ]
  },
  "failure_causes": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "raw_response_ref": {
   "type": [
    "string",
    "null"
   ]
  },
  "final_response_ref": {
   "type": [
    "string",
    "null"
   ]
  },
  "telemetry_ref": {
   "type": [
    "string",
    "null"
   ]
  },
  "artifact_refs": {
   "type": "array"
  }
 }
}