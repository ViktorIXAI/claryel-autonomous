# Local-only publication settings. Copy to ~/.hermes/bench/parb/publish.env
# (or set the same names in the environment). Never commit the filled copy.
#
# Values below are placeholders. Keep real hostnames, addresses, usernames,
# key paths and secret-detection patterns outside the public repository.

# Optional explicit target for public release publication.
# When empty, scripts derive it from `git remote get-url origin`.
export SAH_GITHUB_REPO=''

# Full ssh/scp target strings used by the publication collector.
export SAH_SSH_B2003=''
export SAH_SSH_MAC=''

# Optional JSON array of extra private regex patterns.
# Use this for host-specific values that should never appear in source.
export SAH_SECRET_PATTERNS_JSON='[]'
